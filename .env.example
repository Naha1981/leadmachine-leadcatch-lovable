# LeadMachine server/runtime variables
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
LOVABLE_API_KEY=
OPERATOR_URL=
OPERATOR_API_KEY=
WEBHOOK_SECRET=
CRON_SECRET=
SMS_ALERT_WEBHOOK_URL=
SMS_ALERT_WEBHOOK_SECRET=
SIMULATE_WHATSAPP=false
SIMULATE_SMS=false
WHATSAPP_AUTO_REPLY_ENABLED=true

# Gemini LeadMachine Operator
# Server-side only. Never expose GEMINI_API_KEY to the browser.
GEMINI_API_KEY=
GEMINI_AGENT_ENABLED=true
GEMINI_AGENT_MODEL=gemini-3.8-flash
GEMINI_AGENT_STORE=true

# Demand Radar
DEMAND_RADAR_USER_AGENT=LeadMachine-DemandRadar/1.0 (your-contact-email)

# Zero UI / NahaLLM
NAHALLM_URL=
NAHALLM_API_KEY=
NAHALLM_MODEL=fast
ZERO_UI_TRANSCRIPTION_WEBHOOK_URL=
PLATFORM_OWNER_USER_ID=

# NahaLabs Agent Workforce
# Optional. Server-side only. Never expose these to the browser.
OPENMUSE_BASE_URL=
OPENBOT_BASE_URL=
OPENBOT_AGENT_ID=
OPENBOT_AGUI_URL=
OPENBOT_AGENT_TOKEN=
VIDEO_ENGINE_URL=
VIDEO_ENGINE_API_KEY=
